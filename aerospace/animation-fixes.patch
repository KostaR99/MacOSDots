 import AppKit
 import Common
 
+@MainActor private var windowAnimationGenerations: [UInt32: UInt] = [:]
+
+private struct WindowAnimationFrame: Sendable {
+    let topLeft: CGPoint
+    let size: CGSize
+}
+
+@MainActor
+func isWindowAnimationActive(_ windowId: UInt32) -> Bool {
+    windowAnimationGenerations[windowId] != nil
+}
+
+@MainActor
+private func beginWindowAnimation(_ windowId: UInt32) -> UInt {
+    let generation = (windowAnimationGenerations[windowId] ?? 0) &+ 1
+    windowAnimationGenerations[windowId] = generation
+    return generation
+}
+
+@MainActor
+private func finishWindowAnimation(_ windowId: UInt32, generation: UInt) {
+    Task {
+        try? await Task.sleep(for: .milliseconds(100))
+        if windowAnimationGenerations[windowId] == generation {
+            windowAnimationGenerations[windowId] = nil
+        }
+    }
+}
